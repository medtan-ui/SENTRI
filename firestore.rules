rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for a signed-in user whose users/{uid} profile has
    // role == 'admin'. Used to gate the Training Curriculum collections
    // below — configuration data (lessons, scenarios, quizzes,
    // assignments), not privileged account operations, which stay in
    // functions/index.js per this project's existing security model.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // SENTRI's curriculum is fixed at exactly these six modules (see
    // src/pages/Admin/Modules/mockModules.js) — used below to scope the
    // student lazy-seed exception to real modules only, never an
    // arbitrary document id.
    function isRealModuleId(moduleId) {
      return moduleId in [
        'password-security', 'phishing-awareness', 'malware-awareness',
        'safe-browsing', 'data-privacy', 'online-safety'
      ];
    }

    match /users/{userId} {
      // A signed-in user may read only their own profile — this is how
      // authService.js resolves role on login/session restore.
      allow read: if request.auth != null && request.auth.uid == userId;

      // No client (student, admin, or otherwise) writes here directly.
      // Account creation/deletion/role changes happen exclusively through
      // the admin-only Cloud Functions in functions/index.js, which use
      // the Admin SDK and are not subject to these rules.
      allow write: if false;
    }

    match /auditLogs/{logId} {
      // Written only by Cloud Functions (Admin SDK, bypasses these rules).
      // Not even admins read this directly from the client — see the
      // admin-only getAuditLog callable in functions/index.js.
      allow read, write: if false;
    }

    // ── Training Curriculum configuration data ──────────────────────
    // Still admin-only for write everywhere — content authoring stays on
    // the admin Module Configuration pages. Every collection here is now
    // readable by any signed-in student, because the student pages now
    // genuinely read them: the dashboard/progress system reads `modules`
    // for moduleOrder/status, the Quiz page reads `moduleQuizzes`, and
    // the Lesson Viewer and Scenario Engine read `moduleLessons` and
    // `moduleScenarios` through src/services/moduleLoader.js (which used
    // to serve local mock data instead).
    //
    // Known accepted tradeoff: moduleQuizzes documents store
    // correctChoiceId alongside the questions, so a student who inspects
    // network traffic can see the answer key, and quiz grading happens
    // client-side (the student's own moduleProgress write is what
    // records the result — see below). Closing both gaps properly means
    // a Cloud Function that strips answers server-side and grades
    // attempts itself; deliberately out of scope for now, tracked as a
    // follow-up hardening step rather than silently ignored.
    //
    // Both `modules` and `moduleQuizzes` lazily seed their own document
    // from static mock content the first time anyone reads a module that
    // no admin has opened in the Configuration pages yet (see
    // getOrSeedDoc in firestoreDoc.js) — including a student, if they
    // happen to be first. That seed write has to be allowed for
    // students too, or their very first dashboard/quiz load throws
    // permission-denied forever until an admin visits that module first.
    // Scoped narrowly: only a *create* of a *real* module id, content
    // unchanged after that except by an admin.
    match /modules/{moduleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isRealModuleId(moduleId);
      allow update, delete: if isAdmin();
    }

    // Published lesson content and scenario configuration. Any signed-in
    // user may read — that read IS the student Lesson Viewer / Scenario
    // Engine. Unlike `modules` and `moduleQuizzes` there is deliberately
    // no student lazy-seed create here: the student path
    // (readLesson/readScenario) never writes, and falls back to the
    // authored content in src/data/moduleContent and
    // src/features/scenario/configs when a document doesn't exist yet.
    // So a student who opens a module before any admin has is served
    // real content without ever needing write access.
    match /moduleLessons/{moduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /moduleScenarios/{moduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /moduleQuizzes/{moduleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isRealModuleId(moduleId);
      allow update, delete: if isAdmin();
    }

    // Per-module pre-test — ungraded baseline check a student takes once,
    // the first time they open a module. Same lazy-seed shape as
    // moduleQuizzes: any signed-in user reads, only a real module id may be
    // (lazily) created, and only an admin could ever edit the questions.
    match /modulePretests/{moduleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isRealModuleId(moduleId);
      allow update, delete: if isAdmin();
    }

    match /moduleAssignments/{moduleId} {
      allow read, write: if isAdmin();
    }

    // ── Final assessment ─────────────────────────────────────────────
    // One config document for the whole curriculum (id 'config'), not one
    // per module — the six per-module post-tests were replaced by this
    // single end-of-curriculum test. Same lazy-seed shape as
    // moduleQuizzes: any signed-in user may read it (that read IS the
    // student assessment page), a student may create it if they are the
    // first to open it, and only an admin may edit it afterward. It
    // carries correctChoiceId for the same accepted tradeoff documented
    // above — grading itself is server-side, in submitFinalAssessment.
    match /finalAssessment/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && docId == 'config';
      allow update, delete: if isAdmin();
    }

    // A student's own final assessment result. Written exclusively by the
    // submitFinalAssessment Cloud Function (Admin SDK, bypasses these
    // rules) — the score, the pass flag, the attempt count and the stored
    // normalized gain are all things a student must not be able to set
    // for themselves, so every client write is denied outright. Reads are
    // own-document or admin, matching moduleProgress.
    match /finalAssessmentProgress/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // ── Student module progress ──────────────────────────────────────
    // Doc id is `${userId}_${moduleId}`; the userId field is the actual
    // ownership check (the id format is a convention, not something
    // these rules parse). A student may only read/write their own
    // progress row, for any module — never another student's, and never
    // more than one row per write. Nothing is ever deleted; a module a
    // student has progressed through keeps its record even if an admin
    // later disables that module.
    match /moduleProgress/{progressId} {
      // `resource == null` covers the lazy-seed read of a module this
      // student has never touched yet — the doc doesn't exist, so there's
      // nothing to leak, but `resource.data.userId` would otherwise throw
      // a null-evaluation error instead of a clean "not found."
      // isAdmin() is read-only here (matches studentAnalytics/quizAttempts/
      // moduleAnalytics below) — the Individual Analytics view reads any
      // student's progress this way, but create/update stay owner-only, so
      // an admin still can't write another student's progress from the
      // client.
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // resource != null first: an update racing ahead of this doc's own
      // lazy-seed (two effects in the same page, timed independently)
      // must fail as a clean permission-denied, not a null-evaluation
      // error. The client-side fix is to not attempt the update until
      // its own read of this doc has resolved (see useModuleProgress
      // callers); this guard is defense-in-depth for that.
      allow update: if request.auth != null && resource != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Scenario Engine decision telemetry ──────────────────────────
    // One document per decision (including retries), written by a
    // signed-in student for themselves only. No client ever computes
    // analytics from this collection — a Cloud Function is expected to
    // trigger off these writes (see the TODO in scenarioDecisionService.js).
    // Update is allowed only to flip feedbackViewed once the student
    // actually dismisses the feedback panel; nothing else about a
    // decision record may change after it's written, and nothing is
    // ever deleted.
    match /scenarioDecisionRecords/{recordId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackViewed']);
      allow delete: if false;
    }

    // ── Cloud Functions backend collections ──────────────────────────
    // Everything below is written exclusively by the Cloud Functions in
    // functions/src (Admin SDK, bypasses these rules) — submitQuiz,
    // recordAnalyticsEvent, aggregateModuleAnalytics,
    // aggregateStudentAnalytics, and the updateLearningAnalytics trigger.
    // No client (student or admin) ever writes these directly; reads are
    // opened only where an admin dashboard would plausibly want them.
    match /quizAttempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One document per answered question, across the pre-test, the quiz,
    // and the post-test. Written only by submitQuiz/submitAssessment
    // (Admin SDK). Nothing here may be client-writable: it is the
    // evidence item difficulty, discrimination, and per-topic mastery are
    // computed from, and a student able to write it could manufacture
    // their own learning gain. Read is admin-only — a student sees their
    // own results in the submit response, not by querying this.
    match /quizResponses/{responseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read, write: if false;
    }

    match /moduleAnalytics/{moduleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /studentAnalytics/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if false;
    }

    match /learningAnalytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cross-module, class-level rollup (aggregateCohortAnalytics). Admin
    // read only — it aggregates every student's progress, so it is not
    // something an individual student may see.
    match /cohortAnalytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Gamification (points, rank, badges, streak) ──────────────────
    // One document per student, written exclusively by the
    // updateGamificationOnProgress trigger and the gamification callables
    // (Admin SDK, bypasses these rules). Write is closed to every client:
    // points are derived from moduleProgress, and a student able to write
    // here could award themselves a rank they never earned.
    //
    // Read is deliberately narrow — own document, or an admin. The
    // leaderboard does NOT read this collection from the client; it goes
    // through the getLeaderboard callable, which returns only the columns
    // a board needs about other students. Opening this collection up for
    // reads instead would expose every classmate's full record to satisfy
    // a view that shows five names and five numbers.
    match /gamification/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // NOTE: `userBadges` used to be matched here, for a second badge
    // system that briefly existed alongside the one above. It has been
    // removed rather than left in place: an unmatched collection falls
    // through to the default deny below, which is the correct end state
    // for a collection nothing reads or writes any more. Its two badges
    // worth keeping (First Defender, Perfect Gain) now live in the
    // gamification catalog. Any documents left in Firestore from the
    // old system are inert and can be deleted at leisure.

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
