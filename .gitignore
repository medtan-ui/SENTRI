# Dependencies
node_modules/

# Environment variables (contains Firebase config)
.env
.env.local
.env.*.local
# Firebase deploys functions/.env with the code, so it must stay untracked
# too — see functions/.env.example for what belongs in it.
functions/.env
functions/.env.local

# Build output
dist/
dist-ssr/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Firebase emulator artifacts (written by `npm run test:integration`)
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/

# Test output
coverage/

# OS
.DS_Store
Thumbs.db
